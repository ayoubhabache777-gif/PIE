rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isTeacherOf(s) { return request.auth != null && get(/databases/$(db)/documents/sections/$(s)).data.teacher == request.auth.uid; }

    /* رموز الأساتذة: تُنشأ يدويا من لوحة Firebase (Firestore > teacherCodes > Add document، المعرّف = الرمز بأحرف كبيرة).
       يستطيع المستخدم المسجّل قراءة رمز يعرفه فقط، ولا يمكنه سرد القائمة. */
    match /teacherCodes/{c} { allow get: if request.auth != null; }

    /* فهرس أسماء المتدربين الذين أضافهم الأساتذة: يُمكّن المتدرب من إيجاد قسمه باسمه. المعرّف = SHA-256 للاسم المُطبَّع */
    match /rosterIdx/{h}/e/{k} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && k == request.resource.data.sid + '_' + request.resource.data.rid
        && get(/databases/$(db)/documents/sections/$(request.resource.data.sid)).data.teacher == request.auth.uid;
      allow delete: if request.auth != null && get(/databases/$(db)/documents/sections/$(resource.data.sid)).data.teacher == request.auth.uid;
    }

    match /users/{u} {
      allow read: if request.auth != null && request.auth.uid == u;
      allow create: if request.auth != null && request.auth.uid == u && (
        request.resource.data.role == 'student' ||
        (request.resource.data.role == 'teacher' && exists(/databases/$(db)/documents/teacherCodes/$(request.resource.data.code))));
      allow update: if request.auth != null && request.auth.uid == u && request.resource.data.role == resource.data.role;
      allow delete: if request.auth != null && request.auth.uid == u;
    }
    match /codes/{c} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacher == request.auth.uid && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if request.auth != null && resource.data.teacher == request.auth.uid && request.resource.data.teacher == request.auth.uid;
      allow delete: if request.auth != null && resource.data.teacher == request.auth.uid;
    }
    match /sections/{s} {
      allow create: if request.auth != null && request.resource.data.teacher == request.auth.uid
        && request.auth.token.email_verified == true
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow read, update, delete: if request.auth != null && resource.data.teacher == request.auth.uid;
      match /private/{d} {
        allow read, write: if request.auth != null && getAfter(/databases/$(db)/documents/sections/$(s)).data.teacher == request.auth.uid;
      }
      match /answers/{st} {
        allow read: if isTeacherOf(s);
        allow write: if request.auth != null && request.auth.uid == st;
        allow delete: if isTeacherOf(s);
      }
      match /pdfs/{st} {
        allow read: if request.auth != null && (request.auth.uid == st || isTeacherOf(s));
        allow create, update: if request.auth != null && request.auth.uid == st && request.resource.data.n <= 7;
        allow delete: if request.auth != null && (request.auth.uid == st || isTeacherOf(s));
        match /c/{i} {
          allow read: if isTeacherOf(s);
          allow create, update: if request.auth != null && request.auth.uid == st && request.resource.data.d.size() <= 950000;
          allow delete: if request.auth != null && (request.auth.uid == st || isTeacherOf(s));
        }
      }
      match /grades/{st} {
        allow read: if request.auth != null && (isTeacherOf(s) || request.auth.uid == st);
        allow write: if isTeacherOf(s);
      }
      match /students/{st} {
        allow read, write: if isTeacherOf(s);
        allow read, write: if request.auth != null && request.auth.uid == st;
      }
    }
  }
}
